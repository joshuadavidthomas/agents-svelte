#!/usr/bin/env bash
set -euo pipefail

echo "==> Checking agents-svelte toolchain"
node_version="$(node --version)"
pnpm_version="$(pnpm --version)"

if [[ ! "$node_version" =~ ^v22\. ]]; then
  echo "Expected Node.js 22, found $node_version" >&2
  exit 1
fi

if [[ "$pnpm_version" != "11.1.1" ]]; then
  echo "Expected pnpm 11.1.1, found $pnpm_version" >&2
  exit 1
fi

echo "==> Toolchain ready (Node.js $node_version, pnpm $pnpm_version)"
